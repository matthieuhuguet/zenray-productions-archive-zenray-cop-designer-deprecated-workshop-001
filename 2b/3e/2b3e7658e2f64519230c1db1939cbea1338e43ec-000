{
  "name": "Cop dropshadow",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/dropshadow.html",
  "status": "ok",
  "summary_en": "Offsets a copy of the input layer, which can be expanded, streaked and blurred, then composites that shadow beneath the original. Listed as available since Houdini 22.0.",
  "inputs": [
    "source: original layer receiving the drop shadow",
    "mask: optional per-pixel mask scaled by the Mask parameter"
  ],
  "key_parameters": [
    "Mask: mix of new value with original; default 1",
    "Units: Image or Pixels for Offset, Distance, Expansion and Blur",
    "Output Drop Shadow Only: outputs only the shadow, for a separate AOV or later compositing",
    "Mode: Offset (X/Y vector) or Angle and Distance",
    "Color: shadow colour",
    "Multiply with Original: multiplies shadow colour with the original; when off the shadow colour replaces it",
    "Expansion and Maximum Radius: grow or shrink the shadow, with the maximum capping it",
    "Streak and Streak Weight: smear copies along the offset direction",
    "Blurring: Filter (Box or Gaussian, default Gaussian) and Scale Size per axis"
  ],
  "caveats": [
    "Large Expansion values slow performance; Maximum Radius limits the cost.",
    "With Output Drop Shadow Only on, a Blend COP is needed to put the shadow back over the original.",
    "For text shadows or one-directional blur shadows the page points to the Font and Streak Blur nodes."
  ],
  "resume_fr": "Crée une ombre portée à partir d'une copie décalée de la couche, étirable et floutée, placée sous l'original."
}
