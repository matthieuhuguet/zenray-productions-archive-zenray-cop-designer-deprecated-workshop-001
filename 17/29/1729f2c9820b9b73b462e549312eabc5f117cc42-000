{
  "name": "integratevolume",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/integratevolume.html",
  "status": "ok",
  "summary_en": "Integrates a VDB along each camera view ray, computing the line integral, transmittance, minimum or maximum per pixel. It shows how much of a volume lies under each pixel, for example heat distortion driven by a temperature VDB.",
  "inputs": [
    "camera_ref: optional camera defining view rays and the imaging plane",
    "density: the Float or Vector VDB to integrate",
    "vieworigin: per-pixel ray origins, used instead of camera_ref",
    "viewdir: per-pixel ray directions, used instead of camera_ref",
    "mindepth: raymarch minimum boundary",
    "maxdepth: raymarch maximum boundary"
  ],
  "key_parameters": [
    {
      "name": "Operation",
      "meaning": "Integral, Transmittance, Minimum or Maximum"
    },
    {
      "name": "Depth Conversion",
      "meaning": "Distance, Depth or Height; sets how mindepth and maxdepth are read"
    },
    {
      "name": "Density Min/Max, Ramp Mode, Density Ramp, Density Scale",
      "meaning": "remap and shape density before integration"
    },
    {
      "name": "Integration Step Size",
      "meaning": "length of each ray slice"
    },
    {
      "name": "Jitter Scales",
      "meaning": "reduce banding in sample and slice placement"
    },
    {
      "name": "Max Step Count",
      "meaning": "safety limit, default 4096"
    },
    {
      "name": "Transmittance Cutoff",
      "meaning": "early termination; -1 disables it"
    }
  ],
  "caveats": [
    "Transmittance Cutoff can cause false zero transmittance in very dense volumes through rounding error; use -1 for fields that are not optical densities.",
    "Minimum and Maximum return infinity or -infinity when no ray hits."
  ],
  "resume_fr": "Intègre un VDB le long des rayons de la caméra pour obtenir l'intégrale, la transmittance, le minimum ou le maximum par pixel."
}
