{
  "name": "Cop fillconnected",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/fillconnected.html",
  "status": "ok",
  "summary_en": "Fill Connected flood-fills a connected region of a layer, starting at a seed pixel and spreading to neighbors whose values stay within a set tolerance. It replaces the flooded area with a constant value taken from a parameter or from an input image.",
  "inputs": [
    "source: layer to flood",
    "fillvalue: optional layer supplying the fill color",
    "mask: optional per-pixel mask scaling the Mask parameter"
  ],
  "key_parameters": [
    "Signature: layer type accepted by the source",
    "Seed Location: image coordinate where the flood starts",
    "Tolerance: maximum pixel-value difference from the seed that the fill can spread across",
    "Fall Off: ramp adjusting the fill alpha according to how closely pixels match the seed value",
    "Mask: blend amount from 0 to 1; default 1 uses only the new value",
    "Source: Value (Color or ID), Image Location, First Pixel or Last Pixel of the fillvalue input, or Source Location setting the sampling point in that input"
  ],
  "caveats": [
    "Fall Off can reduce the fill intensity, but connectivity itself is binary: the fill is all or nothing when determining connectivity"
  ],
  "resume_fr": "Le nœud Fill Connected remplit une région connexe d'une couche à partir d'un pixel germe, dans une tolérance de valeur donnée."
}
