  "status": "ok",
  "summary_en": "The Laplacian node computes the sum of the second derivatives along the width and height of an input layer, which highlights edges. Its Space and Scale parameters control the magnitude of the result.",
  "inputs": [
    "source: the layer from which the Laplacian is computed"
  ],
  "key_parameters": [
    "Signature: layer type the source accepts",
    "Space: Image, Pixel or Local space used for the computation, which affects the magnitude",
    "Scale: multiplies the source values before the Laplacian is computed",
    "Read Pixels outside Image: lets boundary derivatives read beyond the image edge, useful for seamless Wrap textures",
    "Kernel Size: maximum distance in buffer elements used for derivatives, which reduces stepping on slowly varying values"
  ],
  "caveats": [
    "Changing Space changes the magnitude of the output, not just its appearance",
    "Read Pixels outside Image is best on for Wrap borders; for Clamp, leaving it off avoids artificial flattening",
    "Increasing Kernel Size smooths stepping artifacts when bit depth is limited",
    "For multi-channel inputs the Laplacian is computed separately per channel",
    "Introduced in Houdini 22.0"
  ],
  "resume_fr": "Calcule le laplacien d'une couche, somme des dérivées secondes en largeur et en hauteur, utile pour faire ressortir les contours."
}
