    "source: original layer to dilate or erode",
    "radius: optional per-pixel radius scaled by the Radius parameter",
    "mask: optional per-pixel mask scaled by the Mask parameter"
  ],
  "key_parameters": [
    "Signature: layer type accepted by the source",
    "Mask: mix of new value with original; default 1 uses only the new value",
    "Units: Image, Pixels or Local space for the radius",
    "Radius: dilation amount; positive dilates, negative erodes; clamped by the maximum",
    "Soft Edge: gradient for softer edges",
    "Fill Holes / Remove Specks: dilates inward to patch holes",
    "Maximum Pixel Radius: caps Radius to limit cost"
  ],
  "caveats": [
