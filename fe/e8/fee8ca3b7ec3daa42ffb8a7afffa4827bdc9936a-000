  "summary_en": "Converts an ID layer, VDB or attribute into a float value. It is the reverse of Mono to ID, which turns floats back into integers.",
  "inputs": [
    "id: the original ID layer, VDB or attribute to convert"
  ],
  "key_parameters": [
    {
      "name": "Signature",
      "meaning": "sets the layer type the source accepts"
    },
    {
      "name": "Conversion",
      "meaning": "Cast converts the integer directly to a float; Safe Pack reversibly packs it into a finite, non-denormal float (pack_inttosafefloat VEX); Bitwise reinterprets the integer bits as a float"
    }
  ],
  "caveats": [
    "Cast loses accuracy for integers too large for a float to represent.",
    "Bitwise is reversible, but the float value does not reflect the integer, so it is not useful for direct value comparisons.",
    "Safe Pack gives the most predictable reversible result for most inputs."
  ],
  "resume_fr": "Convertit une couche d'identifiants entiers en valeur flottante, avec trois modes dont Safe Pack, réversible."
