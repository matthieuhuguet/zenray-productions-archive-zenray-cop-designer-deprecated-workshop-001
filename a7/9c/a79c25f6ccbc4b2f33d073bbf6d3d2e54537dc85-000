  "status": "ok",
  "summary_en": "Splits a cable into its individual wires, which are then processed separately; usually placed after Cable Pack. The wires named in Fields are output on output#. Available since version 21.0.",
  "inputs": [
    "cable: the input cable to extract wires from"
  ],
  "key_parameters": [
    {
      "name": "Set Fields from Input",
      "meaning": "Fills the Fields parameters with the wires of the input cable"
    },
    {
      "name": "Fields",
      "meaning": "Number of wires to extract"
    },
    {
      "name": "Name",
      "meaning": "Name of the wire to extract, chosen from the input cable's wires"
    },
    {
      "name": "Index",
      "meaning": "Distinguishes wires sharing a name; first instance is 0"
    },
    {
      "name": "Type",
      "meaning": "Data type of the wire; affects the node signature"
    }
  ],
  "caveats": [
    "Wires are identified by name; Index tells apart wires that share a name"
  ],
  "resume_fr": "Le nœud cableunpack extrait les fils individuels d'un câble, à l'inverse de cablepack."
}