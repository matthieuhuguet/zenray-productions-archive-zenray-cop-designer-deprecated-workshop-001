{
  "name": "Cop derivative",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/derivative.html",
  "status": "ok",
  "summary_en": "Measures how pixel values change along the horizontal and vertical axes of a layer, useful for tasks such as edge detection. Outputs dCdx and dCdy.",
  "inputs": [
    "source: the layer from which derivatives are computed"
  ],
  "key_parameters": [
    "Signature: layer type accepted by the source",
    "Space: Image, Pixel or Local normalisation of the pixel size",
    "Angle: rotates the sampling positions; at 90 degrees the x derivative equals the y derivative at angle 0",
    "Scale: multiplies the output",
    "Offset: adds a value to the output",
    "Read Pixels outside Image: reads beyond the edge for Wrap textures, stays inside for Clamp edges",
    "Kernel Size: widens the distance between sampled pixels to smooth stepping",
    "Difference Mode: Central, Forward or Diagonal finite differences; Diagonal is described as smoothest"
  ],
  "caveats": [
    "Boundary handling is a trade-off between wrapped and clamped textures.",
    "With slowly varying values and limited bit depth the default kernel may give stepped derivatives; raise Kernel Size."
  ],
  "resume_fr": "Calcule les dérivées horizontale et verticale d'une couche, utiles notamment pour détecter les contours."
}
