{
  "name": "idtomask",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/idtomask.html",
  "status": "ok",
  "summary_en": "Creates a mask from an ID layer by selecting which IDs are included, to isolate regions for post-processing.",
  "inputs": [
    "id: the original ID layer to convert",
    "mask: optional per-pixel mask amount, scaled by the Mask parameter"
  ],
  "key_parameters": [
    {
      "name": "ID Pattern",
      "meaning": "group pattern selecting IDs; blank means all IDs"
    },
    {
      "name": "Invert Mask",
      "meaning": "inverts the generated mask"
    },
    {
      "name": "Keep by Range",
      "meaning": "selects IDs by Start and End, or Start and Length, with optional Range Offset; a Range Filter picks an alternating subset"
    },
    {
      "name": "Keep by Chance",
      "meaning": "keeps IDs randomly by Probability (default 0.5); Seed (default 30) changes the pattern"
    },
    {
      "name": "Keep within Mask",
      "meaning": "uses the mask input; Threshold (default 0.5) sets the minimum mask value considered"
    }
  ],
  "caveats": [
    "Start ID and End ID apply only when their toggles are on.",
    "Keep within Mask needs a connected mask input to have any effect.",
    "The page does not document what the Mask parameter is."
  ],
  "resume_fr": "Crée un masque à partir d'une couche d'identifiants, en retenant les IDs par motif, plage, probabilité ou masque."
