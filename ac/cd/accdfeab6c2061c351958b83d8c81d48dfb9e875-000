{
  "name": "Cop denoisetvd",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/denoisetvd.html",
  "status": "ok",
  "summary_en": "Removes white noise by reducing curvature in the image heightfield representation, eliminating high-frequency specks while preserving sharp edges better than a blur. Distinct from Denoise AI.",
  "inputs": [
    "source: layer to denoise",
    "speed: optional mono layer varying denoising speed per pixel; multiplies Speed and should stay below one",
    "mask: optional per-pixel mask scaled by the Mask parameter"
  ],
  "key_parameters": [
    "Signature: layer type accepted by the source",
    "Mask: mix of new and original value; default 1 uses only the new value and sets the affected RGBA channels",
    "Iterations: number of denoising rounds; more removes more noise and more detail, with runtime scaling",
    "Speed: diffusion per round; total diffusion equals Speed multiplied by Iterations"
  ],
  "caveats": [
    "Texture detail is treated as noise and suppressed.",
    "A high Speed can make the process unstable and prevent convergence."
  ],
  "resume_fr": "Supprime le bruit blanc par diffusion de courbure, en gardant les bords nets mais en effaçant les détails fins."
}
