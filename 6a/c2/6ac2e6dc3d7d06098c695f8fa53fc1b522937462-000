    "source: layer or VDB to process",
    "mask (optional): per-pixel mask that scales the Mask blend amount"
  ],
  "key_parameters": [
    "Signature: layer type accepted by the source",
    "Mask: how much of the new value mixes into the original; default 1 uses only the new value",
    "Scale: multiplies the incoming layer",
    "Shift: added to the layer after Scale is applied",
    "Function Class: Arithmetic, Powers or Trigonometry, which reveals the matching operation menu",
    "Arithmetic operations: Absolute, Sign, Normalize, Negate, Reciprocal, Floor, Round, Ceil, Modulus",
    "Power functions: Square Root, pow(x, E), pow(b, x), exp(x), Base-Log, Natural Log",
    "Trigonometric functions: Sin, Cos, Tan, their inverses and hyperbolic variants",
    "Base and Exponent: shown only for Modulus, pow(b, x), Base-Log and pow(x, E)",
    "Angle Units: Radians, Degrees or Circles (2 pi), used only for trigonometry"
  ],
  "caveats": [
    "The page provides no direct atan2() operation; it suggests the UV to Polar COP node for that purpose"
  ],
  "resume_fr": "Le nœud Function applique à une couche une opération arithmétique, puissance ou trigonométrique, mélangée à l'original par un masque."
