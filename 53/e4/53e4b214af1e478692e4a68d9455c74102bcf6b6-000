{
  "name": "maskfromcurves",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/maskfromcurves.html",
  "status": "ok",
  "summary_en": "The Mask from Curves node closes 2D curves and renders them into a black-and-white mask. It can also output a signed distance field (SDF) storing each pixel distance to the curves.",
  "inputs": [
    "size_ref: layer onto which the curves are rendered; if the curves are not on this layer they are projected through its camera",
    "curves: geometry containing the curves to rasterise; open curves are closed first"
  ],
  "key_parameters": [
    "Output Type: Mask (white inside, black outside) or SDF",
    "Invert: reverses inside and outside in the mask or SDF output, without changing id values",
    "Blur: postprocess blur softening the mask edges",
    "Units: blur Size in image space or absolute pixels",
    "Conversion Quality: smoothness of NURBS and Bezier conversion to polygons, at the cost of processing time",
    "Resample / Segment Length: resamples incoming polygons to equal-spaced points using the given world-space segment length",
    "Treat Polygons As: Straight Edges, Subdivision Curves or Interpolating Curves when resampling"
  ],
  "caveats": [
    "Polygon, Bezier and NURBS curves are accepted; non-polygon curves are converted automatically",
    "The id output stores the contributing curve number per pixel, with -1 where no curve contributed",
    "With Blur enabled, the mask can be non-zero in pixels that have no id",
    "Interpolating Curves preserve size but can introduce overshoots and oscillations",
    "Documented as available since version 21.0"
  ],
  "resume_fr": "Ferme des courbes 2D et les rend en masque noir et blanc, ou en champ de distance signée qui indique la distance de chaque pixel aux courbes."
}
