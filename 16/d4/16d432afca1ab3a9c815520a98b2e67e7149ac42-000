{
  "name": "hsv",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/hsv.html",
  "status": "ok",
  "summary_en": "Converts images between RGB and HSV so HSV values can be edited and converted back; also applies global hue, saturation and value adjustments. The page is titled HSV Adjust.",
  "inputs": [
    "source: the layer, VDB or attribute to process",
    "hueshift: optional per-pixel hue amount",
    "saturation: optional per-pixel saturation amount",
    "value: optional per-pixel brightness amount",
    "mask: optional per-pixel mask amount"
  ],
  "key_parameters": [
    {
      "name": "Operation",
      "meaning": "Hue/Sat/Val Adjust, Convert RGB to HSV, or Convert HSV to RGB"
    },
    {
      "name": "Hue Shift",
      "meaning": "rotates hues by a number of degrees; grays are unaffected"
    },
    {
      "name": "Hue Shift Mode",
      "meaning": "Min/Max remaps the hueshift input to degrees; Width remaps it to a degree range"
    },
    {
      "name": "Saturation Scale / Saturation Shift",
      "meaning": "multiply or add to saturation"
    },
    {
      "name": "Value Scale / Value Shift",
      "meaning": "multiply or add to brightness"
    },
    {
      "name": "Keep Luminance",
      "meaning": "preserves perceived brightness when hues change"
    },
    {
      "name": "Mask",
      "meaning": "blends the new result with the original; default 1 uses only the new value"
    }
  ],
  "caveats": [
    "Saturation Shift is mainly for reducing saturation; increasing it can give grayscale areas random colors.",
    "Enable Treat RGBA as Premultiplied if alpha is premultiplied."
  ],
  "resume_fr": "Convertit entre RGB et HSV pour modifier la teinte, la saturation et la luminosité, puis reconvertit le résultat en RGB."
}
