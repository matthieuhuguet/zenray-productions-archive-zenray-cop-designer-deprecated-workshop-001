{
  "name": "heightfield_terrace",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/heightfield_terrace.html",
  "status": "ok",
  "summary_en": "Turns the slopes of a heightfield into stepped plains by quantizing the input height into discrete steps and blending those terraces with the original height. Outputs height, mesa (terrace floors) and cliffs (terrace walls).",
  "inputs": [
    "height: the height layer to add terraces to",
    "mask: optional per-pixel mask scaled by the Mask parameter"
  ],
  "key_parameters": [
    {
      "name": "Mask",
      "meaning": "how much of the terraces is mixed with the original height"
    },
    {
      "name": "Min Height / Max Height (Compute Range)",
      "meaning": "height band where terraces are created"
    },
    {
      "name": "Method",
      "meaning": "Step Size sets each step height directly; Number of Terraces divides the min-to-max range"
    },
    {
      "name": "Offset",
      "meaning": "shifts where each step occurs"
    },
    {
      "name": "Random Step",
      "meaning": "varies the height added to each level; 0 gives equal steps"
    },
    {
      "name": "Add Layers / Layers / Seed",
      "meaning": "adds extra terrace layers with random offsets"
    },
    {
      "name": "Global Seed",
      "meaning": "randomizes steps and layers"
    }
  ],
  "caveats": [
    "Random Step and Seed only matter when Random Step is non zero or Add Layers is enabled.",
    "The node outputs height, mesa and cliffs."
  ],
  "resume_fr": "Transforme les pentes d'un champ de hauteur en paliers par quantification en marches, avec sorties height, mesa et cliffs."
}
