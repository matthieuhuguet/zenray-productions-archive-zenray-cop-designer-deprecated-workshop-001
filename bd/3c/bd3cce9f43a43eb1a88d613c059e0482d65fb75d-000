{
  "name": "camerafrompoints",
  "url": "https://www.sidefx.com/docs/houdini/nodes/cop/camerafrompoints.html",
  "status": "ok",
  "summary_en": "Solves a camera's aspect ratio, focal length, rotation and absolute position from known 3D world points and their matching 2D image projections, using a Perspective-n-Point algorithm with RANSAC to reject outliers. Output named camera. Listed as available since 22.0; the page states this node type is hidden and no longer supported.",
  "inputs": [
    "matches: image-world point correspondences, identified by the World and Image Point Attribute parameters",
    "layer: the layer the solved camera parameters are applied to"
  ],
  "key_parameters": [
    {
      "name": "World Point Attribute / Image Point Attribute",
      "meaning": "Attributes on matches holding world and image coordinates"
    },
    {
      "name": "Edit Intrinsics / Focal Length",
      "meaning": "Enables known intrinsics so the solver does not estimate them"
    },
    {
      "name": "Camera Center / Image Center / Use Estimator",
      "meaning": "Projective centre set manually or estimated with an orthocenter estimator; defaults to the image origin"
    },
    {
      "name": "Parallel Lines / Line A# / Line B#",
      "meaning": "Axes used by the orthocenter estimator"
    },
    {
      "name": "RANSAC Seed / Iterations / Tolerance",
      "meaning": "Random point selection, loop count, reprojection error threshold"
    },
    {
      "name": "Subset Mode",
      "meaning": "Percentage or Count of correspondences per candidate; default fixed count of 7"
    },
    {
      "name": "PnP Reprojection Error",
      "meaning": "Tolerance used when intrinsics are assumed and there are 3 to 6 correspondences"
    },
    {
      "name": "Apply Estimated Intrinsics",
      "meaning": "Writes the solved aspect ratio, aperture and focal length to camera"
    }
  ],
  "caveats": [
    "The page states this node type is hidden and no longer supported",
    "Fewer than 7 correspondences requires known intrinsics; the minimum is 3",
    "The default centre assumption can give unreliable results where the projective centre is cropped or unknown",
    "The page title matches; the internal name is not printed on the page, so verify it in Houdini"
  ],
  "resume_fr": "Le nœud camerafrompoints retrouve la caméra à partir de points 3D connus et de leurs projections 2D, mais la page le déclare masqué et non plus pris en charge."
}