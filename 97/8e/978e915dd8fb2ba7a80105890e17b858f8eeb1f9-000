  "summary_en": "Combines two cables into a single output cable named merge; the Operation parameter sets how the wires of the two inputs are merged. Available since version 21.0.",
  "inputs": [
    "input_cable: the first cable",
    "reference: the second cable"
  ],
  "key_parameters": [
    {
      "name": "Operation",
      "meaning": "Union (first cable then new wires of second), Intersection (wires in both, data from first), Difference (wires of first absent from second), Copy (second structure, first data preferred, second as fallback), Full Union (all wires of both, duplicates kept), Rename (first data named after second wires)"
    }
  ],
  "caveats": [
    "With Rename, the output is truncated to the wire count of the second cable if it has fewer wires",
    "Full Union keeps duplicate wires, unlike Union"
  ],
  "resume_fr": "Le nœud cablemerge fusionne deux câbles en un seul selon le mode choisi (union, intersection, différence, copie, union complète ou renommage)."
